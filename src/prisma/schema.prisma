// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole

  orgId            String?       @map("org_id") @db.Uuid
  organization     Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeCode     String?       @map("employee_code")
  isVerified       Boolean       @default(false) @map("is_verified")
  refreshTokenHash String?       @map("refresh_token_hash")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  trips Trip[]

  @@unique([orgId, employeeCode])
  @@index([orgId])
  @@index([role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATOR
  CONDUCTOR
  PASSENGER
}

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @map("tenant_id")
  name         String
  contactEmail String   @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")

  users  User[]
  routes Route[]
  buses  Bus[]
  trips  Trip[]

  @@map("organizations")
}

model SeatLayout {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layoutName String   @unique @map("layout_name")
  config     Json
  createdAt  DateTime @default(now()) @map("created_at")

  buses Bus[]

  @@index([id])
  @@map("seat_layouts")
}

model Stop {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  longitude Decimal? @db.Decimal(9, 6)
  latitude  Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now()) @map("created_at")

  routeStops RouteStops[]

  @@map("stops")
}

model Route {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label        String
  orgId        String       @map("org_id") @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  routeStops RouteStops[]
  trips      Trip[]

  @@unique([label, orgId])
  @@map("routes")
}

model RouteStops {
  id                         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stopId                     String @map("stop_id") @db.Uuid
  stop                       Stop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  routeId                    String @map("route_id") @db.Uuid
  route                      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequenceOrder              Int    @map("sequence_order")
  distanceFromPrevStop_Km    Float  @map("distance_from_prev_stop_km")
  travelTimeFromPrevStop_Min Int    @map("travel_time_from_prev_stop_min")

  @@index([routeId, sequenceOrder])
  @@index([stopId])
  @@map("route_stops")
}

model Bus {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label              String
  orgId              String       @map("org_id") @db.Uuid
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  layoutId           String       @map("layout_id") @db.Uuid
  layout             SeatLayout   @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  registrationNumber String       @unique @map("registration_number")
  busClass           BusClasses   @map("bus_class")

  trips Trip[]

  @@map("buses")
}

enum BusClasses {
  SEATER
  SEMI_SLEEPER
  SLEEPER
  AC_SEATER
  AC_SEMI_SLEEPER
  AC_SLEEPER
}

model Trip {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routeId         String       @map("route_id") @db.Uuid
  route           Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  conductorId     String       @map("conductor_id") @db.Uuid
  conductor       User         @relation(fields: [conductorId], references: [id])
  busId           String       @map("bus_id") @db.Uuid
  bus             Bus          @relation(fields: [busId], references: [id], onDelete: Cascade)
  driverName      String       @map("driver_name")
  driverLicense   String       @map("driver_license")
  departureTime   DateTime     @map("departure_time")
  arrivalTime     DateTime     @map("arrival_time")
  baseFare        Float        @map("base_fare")
  status          TripStatus   @default(SCHEDULED)
  createdAt       DateTime     @default(now())
  fareMultipliers Json         @map("fare_multipliers")

  @@index([routeId])
  @@map("trips")
}

enum TripStatus {
  SCHEDULED
  BOARDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
